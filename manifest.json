{
  "manifest_version": 3,
  "name": "Meet Improve",
  "version": "0.5.0",
  "description": "Выделение текста и перевод субтитров Google Meet через локальный Codex (ChatGPT).",
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "js": [
        "captions.js",
        "content.js"
      ]
    }
  ],
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
